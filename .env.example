# Night Shift configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
# deploy/up.sh loads the secrets below into Vault; the pods read them from there.

# --- Console and webhooks -----------------------------------------------------
PASSCODE=change-me                    # unlocks talking, approving and revoking in the console
ALERT_WEBHOOK_TOKEN=change-me         # Alertmanager -> Night Shift
AUDIT_WEBHOOK_TOKEN=change-me         # Kubernetes API server audit webhook -> Night Shift
APPLY_ENABLED=true                    # false = kill switch for every write path

# --- Bolna voice AI (https://platform.bolna.ai) ---------------------------------
BOLNA_API_KEY=                        # bn-... ; backend only, never sent to the browser
BOLNA_AGENT_ID=                       # created by `make bolna-agent`
BOLNA_TOOL_TOKEN=change-me            # bearer token Bolna sends on custom function calls
BOLNA_WEBHOOK_SECRET=change-me        # shared secret on the execution webhook
BOLNA_PUBLIC_URL=                     # https URL where Bolna can reach this API (tunnel/ingress)
BOLNA_API_BASE=https://api.bolna.ai
# Non-AWS speech and LLM providers for the Bolna agent (polly and bedrock are refused)
BOLNA_STT_PROVIDER=deepgram
BOLNA_STT_MODEL=nova-3
BOLNA_LLM_PROVIDER=openai
BOLNA_LLM_MODEL=gpt-4.1-mini
BOLNA_TTS_PROVIDER=elevenlabs
BOLNA_TTS_MODEL=eleven_turbo_v2_5
BOLNA_TTS_VOICE=Angelica
BOLNA_TTS_VOICE_ID=IkSv4tkouLJ6kYsQA7XD
BOLNA_WEBHOOK_IPS=13.203.39.153,13.126.9.249,13.202.133.53
BOLNA_ALLOWED_IPS=                    # optional allowlist for custom function calls
BOLNA_FROM_NUMBER=                    # optional: outbound phone calls
CALL_ENABLED=false
ONCALL_PHONE=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=beacon
DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

# --- NATS JetStream, Temporal ---------------------------------------------------
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Ollama (local model for diagnosis and typed turns) -------------------------
OLLAMA_API_BASE=http://localhost:11434
LLM_MODEL_ID=ollama_chat/qwen2.5:7b
EMBEDDING_MODEL_ID=ollama/nomic-embed-text

# --- Prometheus, Loki, OPA -------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
LOG_SELECTORS={namespace="demo"}
OPA_URL=http://localhost:8181

# --- Kubernetes -----------------------------------------------------------------
KUBECONFIG=
BEACON_NAMESPACE=beacon
REMEDIABLE_NAMESPACES=demo
REMEDIABLE_DEPLOYMENTS=demo/demo-api
GOLDEN_TARGETS=demo/demo-db-ingress

# --- Vault, MinIO ---------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=change-me-dev-root-token
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=beacon
MINIO_SECRET_KEY=change-me-minio

# --- GitHub (fix-at-source pull requests, deployment events) --------------------
FIX_PR_REPO=                          # owner/name
GITHUB_PR_TOKEN=                      # fine-grained: contents + pull requests on that repo
GITHUB_WEBHOOK_SECRET=                # verifies X-Hub-Signature-256 on /github/events

# --- Notifications --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
DASHBOARD_URL=http://localhost:30080
