# Night Shift configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
# deploy/up.sh loads the secrets below into Vault; the pods read them from there.

# --- Console and webhooks -----------------------------------------------------
PASSCODE=change-me                    # unlocks talking, approving and revoking in the console
ALERT_WEBHOOK_TOKEN=change-me         # Alertmanager -> Night Shift
AUDIT_WEBHOOK_TOKEN=change-me         # Kubernetes API server audit webhook -> Night Shift
APPLY_ENABLED=true                    # false = kill switch for every write path

# --- OmniDimension voice (https://docs.omnidim.io) --------------------------------
OMNIDIM_API_KEY=                      # backend only, never sent to the browser
OMNIDIM_AGENT_ID=                     # integer id of the agent you created in the OmniDimension dashboard
OMNIDIM_TOOL_TOKEN=change-me          # bearer your agent's custom API tools send to /voice/omnidim/tools/*
OMNIDIM_ALLOWED_IPS=                  # optional allowlist for tool calls
# Voice is read/propose only. Approval is always the typed phrase in the console.

# --- Bifrost model gateway (https://docs.getbifrost.ai) ------------------------------
BIFROST_URL=                          # e.g. http://localhost:8080 (the gateway, not Night Shift's API)
BIFROST_MODEL=                        # e.g. anthropic/claude-sonnet-4-5 (provider/model as Bifrost names it)
BIFROST_FALLBACK_MODELS=              # optional, comma separated
BIFROST_VIRTUAL_KEY=                  # optional x-bf-vk

# --- Tavily external research ---------------------------------------------------------
TAVILY_API_KEY=

# --- Evidence pipeline / demo -----------------------------------------------------------
CORRELATOR_URL=http://localhost:9103  # Pathway process health
CORRELATION_WINDOW_SECONDS=600
SANDBOX_CONTEXTS=                     # comma list of kube contexts remediation may mutate (demo-simulator for the simulator)
SANDBOX_NAMESPACES=                   # defaults to REMEDIABLE_NAMESPACES
REQUIRE_SANDBOX=false                 # true = refuse to mutate unless SANDBOX_CONTEXTS is set
LEGACY_TRIAGE=true                    # false = disable the original Ollama triage consumer (demo sets false)
SIMULATOR_URL=                        # set by `make demo-up` in sim mode; never set against a real cluster

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=beacon
DATABASE_URL=postgresql://beacon:beacon@localhost:5432/beacon

# --- NATS JetStream, Temporal ---------------------------------------------------
NATS_URL=nats://localhost:4222
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- Ollama (local model for diagnosis and typed turns) -------------------------
OLLAMA_API_BASE=http://localhost:11434
LLM_MODEL_ID=ollama_chat/qwen2.5:7b
EMBEDDING_MODEL_ID=ollama/nomic-embed-text

# --- Prometheus, Loki, OPA -------------------------------------------------------
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
LOG_SELECTORS={namespace="demo"}
OPA_URL=http://localhost:8181

# --- Kubernetes -----------------------------------------------------------------
KUBECONFIG=
BEACON_NAMESPACE=beacon
REMEDIABLE_NAMESPACES=demo
REMEDIABLE_DEPLOYMENTS=demo/demo-api
GOLDEN_TARGETS=demo/demo-db-ingress

# --- Vault, MinIO ---------------------------------------------------------------
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=change-me-dev-root-token
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=beacon
MINIO_SECRET_KEY=change-me-minio

# --- GitHub (fix-at-source pull requests, deployment events) --------------------
FIX_PR_REPO=                          # owner/name
GITHUB_PR_TOKEN=                      # fine-grained: contents + pull requests on that repo
GITHUB_WEBHOOK_SECRET=                # verifies X-Hub-Signature-256 on /github/events

# --- Notifications --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
DASHBOARD_URL=http://localhost:30080
