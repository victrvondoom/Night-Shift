+++ b/plugins/logging/metadatasize_test.go
@@ -0,0 +1,43 @@
+package logging
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/maximhq/bifrost/core/schemas"
+)
+
+// A caller-controlled x-bf-lh-* label, logging header or dimension must not be able to write an
+// arbitrarily large value into every log row when max_metadata_value_bytes is set.
+func TestCaptureLoggingHeadersCapsValueSize(t *testing.T) {
+	loggingHeaders := []string{"x-custom-*"}
+	plugin := &LoggerPlugin{loggingHeaders: &loggingHeaders, maxMetadataValueBytes: 16}
+	ctx := schemas.NewBifrostContext(context.Background(), schemas.NoDeadline)
+	ctx.SetValue(schemas.BifrostContextKeyRequestHeaders, map[string]string{
+		"x-bf-lh-blob":   strings.Repeat("A", 60000),
+		"x-bf-lh-short":  "ok",
+		"x-custom-trace": strings.Repeat("B", 100),
+		"x-bf-lh-utf8":   strings.Repeat("é", 20), // 2 bytes per rune: must not be split mid-rune
+	})
+	ctx.SetValue(schemas.BifrostContextKeyDimensions, map[string]string{"region": strings.Repeat("C", 50)})
+
+	got := plugin.captureLoggingHeaders(ctx)
+	for key, val := range got {
+		if s, ok := val.(string); ok && len(s) > 16 {
+			t.Errorf("%s: value of %d bytes exceeds the 16 byte cap", key, len(s))
+		}
+	}
+	if got["short"] != "ok" {
+		t.Fatalf("a value under the cap must be untouched, got %#v", got["short"])
+	}
+	if s := got["utf8"].(string); s != strings.Repeat("é", 8) {
+		t.Fatalf("expected a rune-aligned truncation, got %q", s)
+	}
+
+	unlimited := &LoggerPlugin{}
+	ctx.SetValue(schemas.BifrostContextKeyRequestHeaders, map[string]string{"x-bf-lh-blob": strings.Repeat("A", 60000)})
+	if v := unlimited.captureLoggingHeaders(ctx)["blob"].(string); len(v) != 60000 {
+		t.Fatalf("the default (0) must keep today's unlimited behaviour, got %d bytes", len(v))
+	}
+}
